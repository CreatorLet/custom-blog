# Keep these private; NEVER put secrets in blog.config.json
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-a-random-32-plus-character-secret
# For deployment, use a PRIVATE GitHub repository and fine-grained content permission.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_TOKEN=
GITHUB_BRANCH=main
# Optional: NEXT_PUBLIC_SITE_URL overrides blog.config.json URL during development
